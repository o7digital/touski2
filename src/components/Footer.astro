---
import { locales, site } from '../data/site.js'
const { content } = Astro.props
---
<footer class="border-t border-white/10 bg-[#050a08]">
  <div class="shell grid gap-10 py-14 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <p class="text-xl font-semibold tracking-[.3em]">TOUSKI</p>
      <p class="mt-4 max-w-sm text-sm leading-7 text-white/60">{content.footer.tagline}</p>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[.2em] text-white/45">{content.nav.contact}</h2>
      <address class="mt-4 text-sm not-italic leading-7 text-white/65">
        {site.address}<br />
        <a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a><br />
        <a href={site.phoneHref} class="hover:text-white">{site.phone}</a>
      </address>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[.2em] text-white/45">{content.footer.languages}</h2>
      <nav class="mt-4 flex flex-wrap gap-3 text-sm" aria-label={content.footer.languages}>
        {Object.values(locales).map((locale) => <a href={locale.path} hreflang={locale.hreflang} class="rounded-full border border-white/15 px-3 py-2 text-white/70 hover:text-white">{locale.lang.toUpperCase()}</a>)}
      </nav>
    </div>
  </div>
  <div class="border-t border-white/10 py-6">
    <p class="shell text-xs text-white/40">© {new Date().getFullYear()} TOUSKI. {content.footer.rights}</p>
  </div>
</footer>
