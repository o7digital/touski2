---
import BaseLayout from '../layouts/BaseLayout.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import { locales } from '../data/site.js'
const content = locales.fr
---
<BaseLayout title="Page introuvable | TOUSKI" description="Cette page n’existe pas ou a été déplacée." canonicalPath="/404" noIndex={true}>
  <Header content={content} />
  <main class="shell flex min-h-[65svh] items-center py-20">
    <div><p class="eyebrow">Erreur 404</p><h1 class="mt-5 text-5xl font-semibold md:text-7xl">Cette piste s’arrête ici.</h1><p class="mt-6 max-w-xl text-lg leading-8 text-white/65">La page demandée n’existe pas ou a été déplacée. Revenez à l’accueil pour poursuivre votre recherche.</p><a href="/" class="mt-8 inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-[#102018]">Retour à l’accueil</a></div>
  </main>
  <Footer content={content} />
</BaseLayout>
